:root {
  --purple: #5c32ff;
  --purple-2: #7946ff;
  --ink: #111217;
  --muted: #6d7280;
  --line: #e6e8ee;
  --surface: #ffffff;
  --canvas: #f6f7f9;
  --red: #ff3b42;
  --orange: #ff8a24;
  --green: #21aa67;
  --blue: #2e6df6;
}

/* 전체 화면: 1920×1080과 일반 노트북 화면에서 한 페이지에 들어오도록 밀도를 조정했습니다. */
.app-shell { min-height: 100vh; background: var(--canvas); }
.sidebar { position: fixed; inset: 0 auto 0 0; width: 176px; background: #060607; color: white; padding: 16px 11px 13px; z-index: 20; display: flex; flex-direction: column; }
.brand { display: flex; align-items: center; gap: 9px; padding: 3px 7px 17px; font-size: 18px; font-weight: 700; }
.brand-icon { font-size: 25px; }
.sidebar nav { display: grid; gap: 3px; }
.nav-item { border: 0; color: #f0f0f3; background: transparent; border-radius: 8px; padding: 9px 10px; text-align: left; display: flex; align-items: center; gap: 10px; font-size: 13px; }
.nav-item:hover { background: #17171b; }
.nav-item.active { background: linear-gradient(100deg, #4228eb, #722cff); }
.nav-icon { width: 20px; height: 20px; display: inline-grid; place-items: center; font-size: 18px; }
.sidebar-bottom { margin-top: auto; border-top: 1px solid #28282d; padding-top: 12px; }
.sidebar-bottom p { margin: 0 0 10px 4px; color: #c9c9cf; font-size: 13px; }
.mart-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.mart-switch button, .model-link { border: 1px solid #29292f; color: white; background: #080809; border-radius: 7px; padding: 8px; }
.mart-switch button.selected { background: linear-gradient(100deg, #4228eb, #722cff); border-color: transparent; }
.model-link { width: 100%; margin-top: 11px; display: flex; justify-content: space-between; }
.app-content { margin-left: 176px; min-height: 100vh; padding: 12px 16px 16px; }
.page-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); padding: 0 4px 10px; margin-bottom: 10px; }
.page-header > div:first-child { display: flex; align-items: baseline; gap: 22px; }
h1, h2, h3, p { margin: 0; }
.page-header h1, .content-title h1 { font-size: 25px; letter-spacing: -1px; }
.page-header span { font-size: 13px; }
.page-header .real-data-badge { color: #087f5b; background: #ddf8ed; border: 1px solid #b8edd9; border-radius: 999px; padding: 3px 8px; font-size: 10px; font-style: normal; font-weight: 700; }
.header-actions { display: flex; gap: 9px; }
.header-actions select, .refresh { border: 1px solid #dfe2e9; background: white; border-radius: 7px; padding: 7px 10px; }
.refresh { width: 40px; }
.summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-bottom: 10px; }
.summary-card { background: var(--surface); border: 1px solid var(--line); border-radius: 11px; min-height: 96px; padding: 13px 13px; display: flex; gap: 11px; box-shadow: 0 2px 6px rgba(18, 25, 40, .03); }
.summary-icon { width: 35px; height: 35px; flex: 0 0 auto; border-radius: 9px; display: grid; place-items: center; font-weight: 700; }
.summary-icon.purple { color: var(--purple); background: #eee9ff; }.summary-icon.red { color: var(--red); background: #ffe7e8; }.summary-icon.blue { color: var(--blue); background: #e8efff; }.summary-icon.green { color: var(--green); background: #e6f7ee; }
.summary-card p { font-size: 12px; font-weight: 600; margin-bottom: 6px; }
.summary-card strong { display: block; font-size: 23px; line-height: 1.1; }
.summary-card strong small { font-size: 12px; margin-left: 4px; font-weight: 500; }
.summary-card span { display: block; margin-top: 6px; color: var(--red); font-size: 10px; }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .48fr); gap: 10px; align-items: start; }
.main-column, .right-column { display: grid; gap: 10px; }
.two-column { display: grid; grid-template-columns: 1.1fr 1fr; gap: 10px; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 2px 6px rgba(18, 25, 40, .025); overflow: hidden; }
.panel-header { display: flex; justify-content: space-between; align-items: center; padding: 11px 13px 8px; }
.panel-header h2 { font-size: 14px; letter-spacing: -.4px; }
.panel-header button { border: 1px solid #dfe2e9; background: white; border-radius: 6px; padding: 6px 9px; font-size: 11px; }
.panel-header > span { color: var(--muted); font-size: 11px; }
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 10px; }
th { text-align: left; color: #606572; background: #fafbfc; font-weight: 500; white-space: nowrap; }
th, td { padding: 7px 8px; border-top: 1px solid #eceef2; }
td { white-space: nowrap; }
td b { font-weight: 600; }
td small { display: block; color: #9095a2; margin-top: 2px; }
tbody tr { transition: background .16s; }
.priority-panel tbody tr { cursor: pointer; }
tbody tr:hover, .selected-row { background: #f5f3ff; }
.risk-badge { display: inline-block; min-width: 34px; text-align: center; border-radius: 4px; padding: 3px 6px; font-size: 10px; font-style: normal; }
.risk-긴급 { color: white; background: var(--red); }.risk-주의 { color: white; background: var(--orange); }.risk-정상 { color: white; background: var(--green); }
.model-chip { color: var(--purple) !important; background: #f0edff; border-radius: 999px; padding: 4px 8px; }
.reason-content { display: grid; grid-template-columns: .82fr 1.18fr; gap: 4px; padding: 1px 12px 8px; min-height: 190px; }
.reason-copy h3 { font-size: 14px; margin: 4px 0 8px; }.reason-copy h3 span { font-size: 11px; font-weight: 500; }
.forecast-tags { display: grid; gap: 7px; }.forecast-tags span { background: #fff1e5; color: #ef5c19; border-radius: 5px; padding: 7px; font-size: 11px; width: fit-content; }
.reason-copy ul { padding-left: 15px; margin: 9px 0 0; font-size: 10px; line-height: 1.65; }
/* 수요 그래프: 실제 수요는 파란색 실선, 예측 수요는 주황색 점선으로 구분합니다. */
.chart-area { min-width: 0; }.line-chart { width: 100%; height: 145px; }.chart-grid { stroke: #e4e7ee; stroke-width: 1; }.chart-axis { stroke: #9aa1ad; stroke-width: 1; }.chart-tick { fill: #737b89; font-size: 8px; }.chart-axis-title { fill: #4b5360; font-size: 8px; font-weight: 600; }.actual-line, .forecast-line { fill: none; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }.actual-line { stroke: #1d4ed8; }.forecast-line { stroke: #f97316; stroke-dasharray: 6 4; }
.chart-legend { display: flex; justify-content: flex-end; gap: 13px; font-size: 10px; margin-top: 2px; }.chart-legend span::before { content: ''; display: inline-block; width: 12px; height: 3px; margin-right: 5px; vertical-align: middle; }.legend-actual::before { background: #1d4ed8; }.legend-forecast::before { background: repeating-linear-gradient(90deg, #f97316 0 5px, transparent 5px 8px); }
.order-layout { display: grid; grid-template-columns: minmax(0, 1fr) 128px; gap: 8px; padding: 0 10px 9px; }
/* 조정 수량 버튼: 1개를 기본 단위로 두고 10개·100개를 빠르게 증감할 수 있습니다. */
.stepper { display: inline-flex; border: 1px solid #e0e3ea; border-radius: 5px; overflow: hidden; }.stepper button { border: 0; min-width: 25px; padding: 4px 3px; background: #fafbfc; font-size: 9px; color: #464d5a; }.stepper button:hover { background: #eeeaff; color: var(--purple); }.stepper span { width: 38px; text-align: center; padding: 4px 2px; border-inline: 1px solid #e0e3ea; font-weight: 700; }
.waiting { color: #2566e9; font-weight: 600; }.approved { color: var(--green); font-weight: 600; }
.approval-summary { border: 1px solid #e5e7ed; border-radius: 9px; padding: 11px 10px; display: flex; flex-direction: column; justify-content: center; }.approval-summary p { color: var(--muted); font-size: 10px; }.approval-summary strong { font-size: 18px; margin: 5px 0 10px; }.approval-summary strong small { font-size: 10px; margin-left: 3px; }.approval-summary b { font-size: 16px; margin: 5px 0 10px; }.approval-summary button { border: 0; color: white; background: linear-gradient(110deg, #5935f5, #6d27ff); border-radius: 7px; padding: 9px 4px; font-size: 11px; }
/* 품절 위험 등급 버튼은 선택된 등급만 목록에 남깁니다. */
.risk-tabs { display: flex; gap: 6px; padding: 0 11px 7px; }.risk-tabs button { border: 0; background: transparent; padding: 4px 7px; font-size: 10px; }.risk-tabs button.active { color: var(--purple); background: #f0edff; border-radius: 4px; font-weight: 700; }
.risk-list { border-top: 1px solid #eceef2; }.risk-list > button { width: 100%; border: 0; border-bottom: 1px solid #eceef2; background: white; display: grid; grid-template-columns: 1fr auto 42px; align-items: center; gap: 7px; padding: 7px 11px; text-align: left; }.risk-list > button:hover { background: #faf9ff; }.risk-list b { display: block; font-size: 10px; }.risk-list small { color: var(--muted); }.risk-list em { font-style: normal; font-size: 10px; text-align: right; }.risk-empty { color: var(--muted); font-size: 10px; text-align: center; padding: 18px 8px; }
.inventory-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 0 9px 8px; }.inventory-stats > div { display: flex; gap: 6px; border: 1px solid #e7e9ef; border-radius: 7px; padding: 7px; }.stock-dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 3px; }.stock-dot.shortage { background: var(--red); }.stock-dot.healthy { background: var(--green); }.stock-dot.excess { background: var(--orange); }.inventory-stats p { font-size: 9px; }.inventory-stats strong { display: block; font-size: 14px; margin-top: 3px; }
.bars { height: 126px; display: flex; align-items: flex-end; justify-content: space-around; padding: 6px 14px 0; border-bottom: 1px solid #edf0f4; }.bar-group { text-align: center; }.bar { height: 96px; width: 22px; display: flex; flex-direction: column-reverse; justify-content: flex-start; border-radius: 3px 3px 0 0; overflow: hidden; background: #f2f3f6; }.bar span { display: block; width: 100%; }.bar-shortage { background: var(--red); }.bar-healthy { background: var(--green); }.bar-excess { background: var(--orange); }.bar-group small { display: block; margin-top: 5px; font-size: 9px; }.bar-legend { display: flex; justify-content: center; gap: 10px; padding: 7px; font-size: 9px; }.bar-legend span:nth-child(1) { color: var(--red); }.bar-legend span:nth-child(2) { color: var(--green); }.bar-legend span:nth-child(3) { color: var(--orange); }
.content-page { min-height: calc(100vh - 48px); }.content-title { margin-bottom: 22px; }.content-title p { color: var(--muted); margin-top: 8px; }.empty-state { min-height: 340px; display: grid; place-content: center; text-align: center; color: var(--muted); }.empty-state strong { font-size: 23px; color: var(--ink); margin-bottom: 10px; }
.toast { position: fixed; right: 24px; bottom: 24px; background: #16171b; color: white; border-radius: 9px; padding: 13px 18px; box-shadow: 0 10px 35px rgba(0,0,0,.22); z-index: 40; }
.modal-backdrop { position: fixed; inset: 0; background: rgba(5, 7, 12, .48); backdrop-filter: blur(3px); z-index: 60; display: grid; place-items: center; padding: 20px; }
.model-modal { width: min(730px, 100%); background: white; border-radius: 16px; box-shadow: 0 24px 70px rgba(0, 0, 0, .25); overflow: hidden; animation: modal-in .18s ease-out; }
.modal-title { display: flex; align-items: flex-start; justify-content: space-between; padding: 21px 24px 17px; border-bottom: 1px solid var(--line); }.modal-title span { color: var(--purple); font-size: 11px; font-weight: 700; }.modal-title h2 { font-size: 21px; margin-top: 4px; }.modal-title button { width: 32px; height: 32px; border: 0; border-radius: 8px; background: #f3f4f7; font-size: 22px; color: #555b68; }
.model-summary { display: grid; grid-template-columns: repeat(3, 1fr); padding: 15px 24px; background: #fafbfc; border-bottom: 1px solid var(--line); }.model-summary > div { padding: 0 15px; border-right: 1px solid var(--line); }.model-summary > div:first-child { padding-left: 0; }.model-summary > div:last-child { border-right: 0; }.model-summary p { font-size: 10px; color: var(--muted); margin-bottom: 5px; }.model-summary strong { font-size: 13px; }
.gauge-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border-bottom: 1px solid var(--line); }.gauge-card { background: white; padding: 16px 12px 7px; min-width: 0; }.gauge-card p { color: #646a78; font-size: 11px; font-weight: 600; }.gauge-card svg { width: 100%; max-height: 115px; overflow: visible; }.gauge-track, .gauge-value { fill: none; stroke-linecap: round; stroke-width: 9; }.gauge-track { stroke: #edf0f3; }.gauge-value { transform-origin: center; transition: stroke-dasharray .4s ease; }.gauge-card text { font-size: 14px; font-weight: 700; fill: #6b7280; }
.model-note { margin: 18px 24px 10px; border-radius: 10px; background: #ebf8f5; display: flex; gap: 12px; padding: 13px 15px; color: #236d63; }.model-note > span { width: 24px; height: 24px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 50%; background: #43c8bd; color: white; }.model-note p { font-size: 12px; line-height: 1.6; }.modal-footnote { color: #969ba6; font-size: 10px; padding: 0 24px 20px; }
@keyframes modal-in { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }

/* 높이가 낮은 데스크톱에서는 대시보드 전체를 같은 비율로 줄여 세로 스크롤을 없앱니다. */
@media (min-width: 1181px) and (max-height: 850px) {
  html, body { overflow: hidden; }
  .app-shell { width: 121.951%; min-height: 121.951vh; transform: scale(.82); transform-origin: top left; }
}

/* 높이가 충분한 데스크톱에서는 남는 공간을 기존 표와 그래프에 자연스럽게 배분합니다. */
@media (min-width: 1181px) and (min-height: 851px) {
  body { overflow: hidden; }
  .app-content { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
  .dashboard-grid { flex: 1; min-height: 0; align-items: stretch; }
  .main-column { min-height: 0; grid-template-rows: minmax(0, 1.05fr) minmax(0, .95fr); }
  .right-column { min-height: 0; grid-template-rows: minmax(0, 1.38fr) minmax(0, .42fr) minmax(0, 1fr); }
  .two-column { min-height: 0; }

  .priority-panel, .reason-panel, .order-panel, .risk-panel, .store-chart { display: flex; flex-direction: column; min-height: 0; }
  .priority-panel .table-scroll { flex: 1; min-height: 0; }
  .priority-panel table { height: 100%; }
  .priority-panel th, .priority-panel td { padding-block: 10px; }

  .reason-content { flex: 1; min-height: 0; align-items: center; }
  .chart-area { align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  .line-chart { height: min(230px, 100%); }

  .order-layout { flex: 1; min-height: 0; }
  .order-layout > .table-scroll { height: 100%; }
  .order-layout table { height: 100%; }

  .risk-list { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .risk-list > button { flex: 1; min-height: 0; }
  .store-chart .bars { flex: 1; height: auto; min-height: 0; }
  .store-chart .bar { height: 130px; }
}

@media (max-width: 1180px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .right-column { grid-template-columns: 1.3fr .8fr .9fr; align-items: start; }
}
@media (max-width: 1080px) {
  .summary-grid { grid-template-columns: repeat(2, 1fr); }
  .two-column, .right-column { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .sidebar { width: 68px; padding-inline: 8px; }.brand span:last-child, .nav-item:not(.active) { font-size: 0; }.brand { justify-content: center; padding-inline: 0; }.nav-item { justify-content: center; }.nav-item.active { font-size: 0; }.nav-icon { font-size: 18px; }.sidebar-bottom { display: none; }
  .app-content { margin-left: 68px; padding: 17px 12px 28px; }.page-header { align-items: flex-start; }.page-header > div:first-child { display: block; }.summary-grid { grid-template-columns: 1fr; }.order-layout { grid-template-columns: 1fr; }.approval-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }.approval-summary button { grid-column: 1 / -1; }.reason-content { grid-template-columns: 1fr; }
  .gauge-grid { grid-template-columns: repeat(2, 1fr); }.model-summary { grid-template-columns: 1fr; gap: 9px; }.model-summary > div { padding: 0; border-right: 0; }.model-modal { max-height: calc(100vh - 24px); overflow-y: auto; }
}
